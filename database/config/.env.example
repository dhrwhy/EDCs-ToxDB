# ============================================================
# MouseToxDB 数据库环境变量
# 复制此文件为 .env 并根据实际环境修改
# ============================================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=mousetoxdb
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# 文件路径 (本地开发)
EXCEL_PATH=/path/to/source_excel.xlsx
ASSETS_DIR=/path/to/deseq_assets

# 文件路径 (Docker 部署)
# EXCEL_PATH=/data/source_excel/source_data.xlsx
# ASSETS_DIR=/data/deseq_assets
# MYSQL_HOST=mysql
